# Copy this file to .env and adapt only local host paths and resource limits.
# Forward slashes avoid ambiguity in Docker Desktop Compose files on Windows.
GAME_DIR=C:/Program Files (x86)/Steam/steamapps/common/Aniimo
STEAM_APP_MANIFEST=C:/Program Files (x86)/Steam/steamapps/appmanifest_4126040.acf

# Every persistent Docker volume receives this literal prefix. Keep the
# trailing separator: the default creates aniimo-inputs, aniimo-state, etc.
ANIIMO_VOLUME_PREFIX=aniimo-

# Starting values for the available 96 GiB workstation. `modkit doctor` will
# eventually verify them before analysis.
CAPTURE_CPUS=4
CAPTURE_MEMORY_LIMIT=4g
ANALYZER_CPUS=12
ANALYZER_MEMORY_LIMIT=32g
GHIDRA_MAX_HEAP=24G

# Linux UID/GID used at image build and runtime. Rebuild the image after a
# change; existing volumes may require an explicit ownership migration.
LOCAL_UID=1000
LOCAL_GID=1000
