{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.aniimo.invalid/schemas/native-coverage-v1.schema.json",
  "title": "Aniimo native coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis_key", "approved_body_count", "body_ids_by_status", "body_status_counts", "build_id", "discovery_complete", "discovery_complete_reason", "exact_body_reconciliation", "expected_methods", "identified_bodies_all_terminal", "schema_version", "unattributed_executable_ranges", "unconfirmed_function_candidates", "unresolved_call_targets"],
  "properties": {
    "schema_version": {"const": 1},
    "analysis_key": {"type": "string", "pattern": "^m2-[0-9a-f]{64}$"},
    "build_id": {"type": "string", "pattern": "^build-[0-9a-f]{64}$"},
    "approved_body_count": {"type": "integer", "minimum": 0},
    "body_status_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asm_only", "c_and_asm", "disassembly_failed", "pending"],
      "properties": {
        "asm_only": {"type": "integer", "minimum": 0},
        "c_and_asm": {"type": "integer", "minimum": 0},
        "disassembly_failed": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0}
      }
    },
    "body_ids_by_status": {"type": "object"},
    "exact_body_reconciliation": {"const": true},
    "identified_bodies_all_terminal": {"type": "boolean"},
    "discovery_complete": {"type": "boolean"},
    "discovery_complete_reason": {"type": "string"},
    "expected_methods": {"type": "object"},
    "unresolved_call_targets": {"type": "array"},
    "unconfirmed_function_candidates": {"type": "array"},
    "unattributed_executable_ranges": {"type": "array"}
  }
}
